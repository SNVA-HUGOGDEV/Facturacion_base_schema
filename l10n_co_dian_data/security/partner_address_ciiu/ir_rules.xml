<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="0">
  
    <record id="address_code_rule_multi_company" model="ir.rule">
        <field name="name">Address Codes por Empresa</field>
        <field name="model_id" ref="model_address_code"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="ciiu_value_rule_multi_company" model="ir.rule">
        <field name="name">CIIU por Empresa</field>
        <field name="model_id" ref="model_ciiu_value"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
    
    <record id="street_code_rule_multi_company" model="ir.rule">
        <field name="name">Street Codes por Empresa</field>
        <field name="model_id" ref="model_street_code"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
    
  </data>
</odoo>
