<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form" model="ir.ui.view">
        <field name="name">hr.employee.view.from.inherit</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='personal_information']//field[@name='address_home_id']"
                position="attributes">
                <attribute name="string">Contacto</attribute>
                <attribute name="context">
                    {}
                </attribute>
            </xpath>
            <xpath expr="//page[@name='personal_information']//field[@name='identification_id']"
                position="attributes">
                <attribute name="invisible">
                    1
                </attribute>
            </xpath>
            <xpath expr="//page[@name='personal_information']//field[@name='identification_id']"
                position="before">
                <field name="state_id" />
                <field name="city_id" />
            </xpath>

            <xpath
                expr="//page[@name='hr_settings']//group[@name='payroll_group']"
                position="inside">
                <field name="payment_method_id" />
                <field name="bank_name" />
                <field name="account_type" />
                <field name="account_number" />
            </xpath>

            <xpath
                expr="//page[@name='hr_settings']//group[@name='active_group']//field[@name='employee_type']"
                position="after">
                <field name="employee_type_dian" />
                <field name="employee_subtype_dian" />
                <field name="high_pension_risk" />
            </xpath>
        </field>
    </record>
</odoo>