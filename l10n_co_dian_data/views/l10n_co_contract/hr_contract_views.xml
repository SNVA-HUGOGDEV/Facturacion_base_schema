<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_contract_form_inherit" model="ir.ui.view">
        <field name="name">hr.contract.view.from.inherit</field>
        <field name="model">hr.contract</field>
        <field name="inherit_id" ref="hr_contract.hr_contract_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='information']//group[@name='salary_info']" position="after">
                <group name="dian_info">
                    <field name="salario_integral" />
                </group>
            </xpath>
        </field>
    </record>
</odoo>