<odoo>
    <data noupdate="0">

        <!-- Regla para restringir documentos DIAN por empresas activas en sesión -->
        <record id="account_invoice_dian_document_rule_multi_company" model="ir.rule">
            <field name="name">Acceso por Empresas Activas</field>
            <field name="model_id" ref="model_account_invoice_dian_document"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

    </data>
</odoo>
