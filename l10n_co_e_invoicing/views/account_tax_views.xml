<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="view_tax_form_l10n_co_e_invoicing" model="ir.ui.view">
        <field name="name">account.tax.form.l10n_co_e_invoicing</field>
        <field name="model">account.tax</field>
        <field name="inherit_id" ref="account.view_tax_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='advanced_options']//field[@name='country_id']"
                position="after">
                <field name="show_in_report" />
            </xpath>
        </field>
    </record>
</odoo>