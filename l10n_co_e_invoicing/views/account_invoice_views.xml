<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <record id="email_template_for_einvoice" model="mail.template">
        <field name="name">Electronic Invoice - Send by Email</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="email_from">{{object.company_id.einvoicing_email}}</field>
        <field name="reply_to">{{object.company_id.einvoicing_email}}</field>
        <field name="subject">{{object.company_id.partner_id.identification_document}};{{object.company_id.name}};{{object.name}};01;{{object.company_id.name}}</field>
        <field name="email_to">{{(object.partner_id.email) or (object.company_id.einvoicing_partner_no_email)}}</field>
        <field name="auto_delete" eval="False"/>
        <field name="lang">{{object.partner_id.lang}}</field>
        <field name="body_html" type="html">
            <div style="font-family: 'Lucica Grande', Ubuntu, Arial, Verdana, sans-serif; font-size: 12px; color: #222222; background-color: #FFF; ">
                <p style="margin:0px 0 12px 0;box-sizing:border-box;">Señor(es),</p>
                <p style="margin:0px 0 12px 0;box-sizing:border-box;">
                    <t t-out="object.partner_id.name or ''" data-oe-t-inline="true" contenteditable="false" oe-keep-contenteditable=""/>
                </p>
                <br/>
                <br/>
                <p style="margin:0px 0 12px 0;box-sizing:border-box;">Le informamos que ha recibido
                    una factura/nota electrónica de <t t-out="object.company_id.name or ''" data-oe-t-inline="true" contenteditable="false" oe-keep-contenteditable="">:</t></p>
                <br/>
                <br/>
                <p style="margin:0px 0 12px 0;box-sizing:border-box;">Número de factura: <strong style="box-sizing:border-box;font-weight:500;">
                        <t t-out="object.name or ''" data-oe-t-inline="true" contenteditable="false" oe-keep-contenteditable=""> </t>
                    </strong></p>
                <p style="margin:0px 0 12px 0;box-sizing:border-box;">Token de factura: <strong style="box-sizing:border-box;font-weight:500;">
                        <t t-out="object.approve_token or ''" data-oe-t-inline="true" contenteditable="false" oe-keep-contenteditable=""> </t>
                    </strong></p>
                <p style="margin:0px 0 12px 0;box-sizing:border-box;">A nombre de: <strong style="box-sizing:border-box;font-weight:500;">
                        <t t-out="object.partner_id.name or ''" data-oe-t-inline="true" contenteditable="false" oe-keep-contenteditable=""> </t>
                    </strong></p>
                <p style="margin:0px 0 12px 0;box-sizing:border-box;">Valor Total: <strong style="box-sizing:border-box;font-weight:500;">
                        <t t-out="object.amount_total or ''" data-oe-t-inline="true" contenteditable="false" oe-keep-contenteditable=""/>
                        <t t-out="object.currency_id.name or ''" data-oe-t-inline="true" contenteditable="false" oe-keep-contenteditable=""/>
                    </strong></p>
                <br/>
                <br/>
                <p style="margin:0px 0 12px 0;box-sizing:border-box;">Si tiene inquietud respecto a
                    la información contenida en la factura/nota electrónica, responda este correo
                    electrónico.</p>
                <br/>


                <p style="margin:0px 0 12px 0;box-sizing:border-box;">Si pasados tres (3) días
                    hábiles siguientes a la recepción de la factura/nota electrónica, no se ha
                    recibido un correo indicando rechazo de la factura/nota electrónica, el sistema
                    la dará por aceptada.</p>
                <br/>
                <p style="margin:0px 0 12px 0;box-sizing:border-box;">Escriba a <t t-out="object.company_id.einvoicing_email or ''" data-oe-t-inline="true" contenteditable="false" oe-keep-contenteditable=""/> si desea modificar sus
                    datos para el envío de la factura/nota electrónica.</p>
                <br/>

                <p style="margin:0px 0 12px 0;box-sizing:border-box;">Cordialmente,</p>
                <br/>
                <p style="margin:0px 0 12px 0;box-sizing:border-box;">
                    <strong style="box-sizing:border-box;font-weight:500;">
                        <t t-out="object.company_id.name or ''" data-oe-t-inline="true" contenteditable="false" oe-keep-contenteditable=""/>
                    </strong>
                </p>
                <table summary="o_mail_notification" style="width:100%;border-top:1px solid #e1e1e1;">
                    <table style="width:100%;text-align:center;">
                        <tbody>
                            <tr>
                                <td>
                                    <a role="button" class="dropdown-toggle o-no-caret btn" t-attf-href="{{ object.get_base_url() }}/mail/view?model=account.move&amp;res_id={{ object.id }}&amp;approve_token={{ object.approve_token }}" style="background-color:#685563;color:#fff;border-radius:10px;font-size:15px">
                                        Ver <t t-out="object.name"/></a>
                                </td>

                                
                            </tr>
                        </tbody>
                    </table>
                </table>
            </div>
        </field>
    </record>
</odoo>
