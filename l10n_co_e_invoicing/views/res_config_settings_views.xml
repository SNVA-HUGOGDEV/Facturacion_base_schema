<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.l10n_co_e_invoicing</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('app_settings_block')]//div[@id='invoicing_settings']"
                position="after">
                <h2>Reportes</h2>
                <div class="row mt16 o_settings_container" id="invoicing_settings">
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="row">
                            <field name="hide_discount" class="col-lg-1 ml16" />
                            <label for="hide_discount" />
                            <span class="fa fa-lg fa-percent"
                                title="Values set here are company-specific." />
                        </div>
                        <div class="row">
                            <field name="hide_uom" class="col-lg-1 ml16" />
                            <label for="hide_uom" />
                            <span class="fa fa-lg fa-sort-alpha-asc"
                                title="Values set here are company-specific." />
                        </div>

                        <div class="row">
                            <field name="hide_iva" class="col-lg-1 ml16" />
                            <label for="hide_iva" />
                            <span class="fa fa-lg fa-percent"
                                title="Values set here are company-specific." />
                        </div>
                       
                        <div class="o_setting_right_pane">
                            <div class="content-group">
                                <div class="mt16">
                                    <div>
                                        <field name="report_header_info"
                                               class="oe_account_terms mt-5 w-100"
                                               placeholder="Información de la empresa"/>
                                    </div>
                                    
                                </div>
                            </div>
                        </div>
                        
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>