<odoo>
    <data noupdate="0">
        <record model="ir.cron" id="l10n_co_e_invoicing.cron_acp_tacita_dian">
            <field name="name">Aceptacion tacita - DIAN</field>
            <field name="model_id" ref="account.model_account_move" />
            <field eval="True" name="active" />
            <field name="state">code</field>
            <field name="code">model.tacit_acceptation()</field>
            <field name="interval_number">1</field>
            <field name="numbercall">-1</field>
            <field name="interval_type">hours</field>
        </record>
    </data>

    <record id="ir_cron_auto_post_dian_entry" model="ir.cron">
        <field name="name">Account: Post confirmed entries (DIAN)</field>
        <field name="interval_number">2</field>
        <field name="interval_type">hours</field>
        <field name="numbercall">-1</field>
        <field name="nextcall" eval="(DateTime.now() + timedelta(hours=2)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="doall" eval="False" />
        <field name="model_id" ref="model_account_move" />
        <field name="code">model._auto_post_dian_entry()</field>
        <field name="state">code</field>
    </record>
</odoo>